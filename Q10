/* Write a program to input time in seconds and convert it to hours:minutes:seconds format.*/
#include <stdio.h>

int main ()
{
int second, minutes, hour;
printf("The time in seconds is: ");
scanf("%d", &second);
hour = second/(60*60);
minutes =  second%60;
second = second/(60*60);
printf("The Time is: %dhr %dmin %ds", hour, minutes, second);
return 0;
}
