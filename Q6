/* Write a program to swap two numbers using a third variable.*/

#include <stdio.h>
int main()
{
int a, b, c;
printf("The first number is: ");
scanf("%d", &a);
printf("The second number is: ");
scanf("%d", &b);
c=a;
a=b;
b=c;
printf("The first number after swaped is: %d\n", a);
printf("The second number after swaped is: %d\n", b);
return 0;
}
